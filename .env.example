# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clerk (registro e ingreso): dashboard.clerk.com > API keys.
# Activar la integración con Supabase en Clerk y agregar Clerk como Third-party Auth en Supabase.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Solo para scripts de carga de datos (seed). No exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para `npm run db:seed`: Project Settings > Database > Connection string (URI).
SUPABASE_DB_URL=

# Asistente con LLM (solo servidor)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-2
